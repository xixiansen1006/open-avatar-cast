# 复制为 .env 后填写；优先级高于 config.yaml 中的同名项

# 服务
OAC_HOST=0.0.0.0
OAC_PORT=8765

# TTS
OAC_TTS_PROVIDER=edge
# OAC_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# OpenAI-compatible TTS（可选）
# OAC_OPENAI_TTS_BASE_URL=http://127.0.0.1:9880/v1
# OAC_OPENAI_TTS_API_KEY=
# OAC_OPENAI_TTS_MODEL=tts-1
# OAC_OPENAI_TTS_VOICE=alloy

# 可选 LLM
OAC_LLM_ENABLED=false
# OAC_LLM_BASE_URL=https://api.openai.com/v1
# OAC_LLM_API_KEY=
# OAC_LLM_MODEL=gpt-4o-mini

# 可选 OBS
OAC_OBS_ENABLED=false
# OAC_OBS_HOST=127.0.0.1
# OAC_OBS_PORT=4455
# OAC_OBS_PASSWORD=
